campaignTrail_temp.issues_json = JSON.parse("[{\"model\": \"campaign_trail.issue\", \"pk\": 2, \"fields\": {\"name\": \"Health Care\", \"description\": \"Health care costs, insurance premiums, Medicaid, prescription drugs, reproductive care, and the future of the Affordable Care Act remain major concerns in 2026. Voters disagree over whether competition or a larger public role offers the best path to affordable coverage.\", \"stance_1\": \"Very Conservative\", \"stance_desc_1\": \"Supports deep reductions in federal health programs and regulation, broad market deregulation, and replacing Medicare or Medicaid guarantees with private alternatives.\", \"stance_2\": \"Conservative\", \"stance_desc_2\": \"Supports repealing or sharply reducing the Affordable Care Act, limiting Medicaid, and relying more heavily on private insurance, tax deductions, and health savings accounts.\", \"stance_3\": \"Leans Conservative\", \"stance_desc_3\": \"Favors private insurance and cost controls, but accepts protections for pre-existing conditions and a limited public safety net.\", \"stance_4\": \"Moderate\", \"stance_desc_4\": \"Supports preserving core coverage protections and targeted public assistance while seeking bipartisan cost reductions and a continued central role for private insurers.\", \"stance_5\": \"Leans Liberal\", \"stance_desc_5\": \"Supports strengthening the Affordable Care Act, expanding Medicaid and subsidies, lowering prescription costs, and protecting reproductive health access.\", \"stance_6\": \"Liberal\", \"stance_desc_6\": \"Supports a public insurance option or major expansion of public coverage, stronger price negotiation, and broader federal guarantees of affordable care.\", \"stance_7\": \"Very Liberal\", \"stance_desc_7\": \"Supports a universal government-run or single-payer system that largely replaces private health insurance.\", \"election\": 3}}, {\"model\": \"campaign_trail.issue\", \"pk\": 3, \"fields\": {\"name\": \"Foreign Policy\", \"description\": \"The United States is engaged in an expanding war with Iran, launched without a formal declaration of war. The conflict, its casualties, fuel-price effects, strategic goals, and the constitutional role of Congress have become the central foreign-policy questions of the 2026 campaign.\", \"stance_1\": \"Very Conservative\", \"stance_desc_1\": \"Supports a major escalation against Iran, including ground forces or regime change if necessary, and grants the president broad authority to wage the conflict without new congressional limits.\", \"stance_2\": \"Conservative\", \"stance_desc_2\": \"Supports the current war and continued strikes until Iran accepts American terms. Favors a strong military posture and is willing to escalate if the administration believes it necessary.\", \"stance_3\": \"Leans Conservative\", \"stance_desc_3\": \"Generally supports military action against Iran but wants clearer objectives, firmer limits, or a specific authorization from Congress before a large escalation.\", \"stance_4\": \"Moderate\", \"stance_desc_4\": \"Seeks a negotiated end while maintaining limited defensive operations. Supports a congressional vote, defined objectives, and safeguards for American forces and allies.\", \"stance_5\": \"Leans Liberal\", \"stance_desc_5\": \"Opposes continuing the war without congressional authorization and favors an urgent ceasefire, diplomacy, and a drawdown of American operations.\", \"stance_6\": \"Liberal\", \"stance_desc_6\": \"Supports ending offensive operations and cutting off funding for an unauthorized war. Rejects another open-ended Middle Eastern conflict and prioritizes diplomacy.\", \"stance_7\": \"Very Liberal\", \"stance_desc_7\": \"Supports immediate withdrawal from the Iran war and a broadly non-interventionist foreign policy, with a substantially smaller overseas military footprint.\", \"election\": 3}}, {\"model\": \"campaign_trail.issue\", \"pk\": 1, \"fields\": {\"name\": \"The Economy\", \"description\": \"Texas voters enter the 2026 election focused on affordability, wages, housing costs, inflation, taxes, tariffs, and the power of large corporations. The central dispute is how aggressively the federal government should intervene in the economy and who should bear the cost.\", \"stance_1\": \"Very Conservative\", \"stance_desc_1\": \"Supports sweeping tax cuts, sharp reductions in federal spending and regulation, and broad privatization. Places few limits on corporate power and strongly opposes redistribution.\", \"stance_2\": \"Conservative\", \"stance_desc_2\": \"Supports lower taxes, deregulation, restrained spending, and a smaller federal role. May accept targeted assistance but generally trusts markets to set wages and prices.\", \"stance_3\": \"Leans Conservative\", \"stance_desc_3\": \"Prefers market-oriented growth and fiscal restraint, while accepting limited relief for families, infrastructure investment, or selective action against unfair trade practices.\", \"stance_4\": \"Moderate\", \"stance_desc_4\": \"Supports a mixed approach to affordability, combining private-sector growth with targeted tax relief, enforcement against abuses, and limited public investment.\", \"stance_5\": \"Leans Liberal\", \"stance_desc_5\": \"Supports stronger labor standards, more progressive taxation, antitrust enforcement, and public investment, while retaining a largely private-market economy.\", \"stance_6\": \"Liberal\", \"stance_desc_6\": \"Supports major increases in worker bargaining power, social spending, regulation, and taxes on wealthy households and large corporations.\", \"stance_7\": \"Very Liberal\", \"stance_desc_7\": \"Supports a fundamental redistribution of economic power, including extensive public ownership or control of major industries and a much larger welfare state.\", \"election\": 3}}, {\"model\": \"campaign_trail.issue\", \"pk\": 5, \"fields\": {\"name\": \"Immigration\", \"description\": \"Border security, asylum, legal immigration, deportation policy, and the treatment of long-settled undocumented residents are central issues in Texas. Voters disagree over mass enforcement, humanitarian obligations, and a possible path to legal status.\", \"stance_1\": \"Very Conservative\", \"stance_desc_1\": \"Supports mass deportation, severe restrictions on legal immigration and asylum, extensive military involvement at the border, and broad detention authority.\", \"stance_2\": \"Conservative\", \"stance_desc_2\": \"Supports large-scale deportations, major reductions in immigration, a heavily fortified border, and narrow asylum rules.\", \"stance_3\": \"Leans Conservative\", \"stance_desc_3\": \"Emphasizes enforcement and removals, but accepts limited legal status for selected long-term residents and some continued legal immigration.\", \"stance_4\": \"Moderate\", \"stance_desc_4\": \"Supports strong border enforcement alongside legal immigration, orderly asylum processing, and a conditional path to status for some long-term residents.\", \"stance_5\": \"Leans Liberal\", \"stance_desc_5\": \"Supports a broad path to legal status, expanded legal immigration, humane asylum procedures, and targeted rather than mass enforcement.\", \"stance_6\": \"Liberal\", \"stance_desc_6\": \"Prioritizes legalization, family unity, due process, and major limits on detention and deportation while maintaining ordinary border administration.\", \"stance_7\": \"Very Liberal\", \"stance_desc_7\": \"Supports very expansive migration and asylum rights, sharply reduced detention and deportation, and minimal criminalization of unauthorized entry.\", \"election\": 3}}, {\"model\": \"campaign_trail.issue\", \"pk\": 4, \"fields\": {\"name\": \"Social Issues\", \"description\": \"Abortion, LGBTQ rights, religion in public life, firearms, voting rights, and civil-rights enforcement continue to divide Texas in 2026. The issue measures whether voters favor traditionalist restrictions or broader personal and civil liberties.\", \"stance_1\": \"Very Conservative\", \"stance_desc_1\": \"Supports sweeping abortion restrictions, strong limits on LGBTQ rights, expansive religious exemptions, very broad gun rights, and aggressive rollback of federal civil-rights protections.\", \"stance_2\": \"Conservative\", \"stance_desc_2\": \"Is strongly anti-abortion and socially traditional, opposes most new gun restrictions, and favors a reduced federal role in civil-rights and LGBTQ protections.\", \"stance_3\": \"Leans Conservative\", \"stance_desc_3\": \"Leans traditionalist but accepts some exceptions and incremental compromise on abortion, LGBTQ policy, firearms, or voting rules.\", \"stance_4\": \"Moderate\", \"stance_desc_4\": \"Takes mixed positions, generally protecting existing individual rights while resisting the most expansive proposals from either side.\", \"stance_5\": \"Leans Liberal\", \"stance_desc_5\": \"Supports abortion access, LGBTQ equality, voting access, and selected gun-safety measures, while allowing some state-level limits or compromises.\", \"stance_6\": \"Liberal\", \"stance_desc_6\": \"Strongly supports reproductive freedom, LGBTQ and civil-rights protections, voting access, church-state separation, and substantial gun-safety legislation.\", \"stance_7\": \"Very Liberal\", \"stance_desc_7\": \"Supports the broadest federal protection of reproductive, LGBTQ, voting, and civil rights, along with sweeping national gun-control measures.\", \"election\": 3}}]");
